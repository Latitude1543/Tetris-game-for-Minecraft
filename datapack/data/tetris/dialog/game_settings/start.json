{
    "type": "minecraft:multi_action",
    "title": "俄罗斯方块小游戏-设置",
    "columns": 1,
    "pause": false,
    "after_action": "none",
    "actions": [
        {
            "label": "音乐",
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger tetris.game.settings set 2"
            },
            "width": 100
        },
        {
            "label": "游戏难度",
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger tetris.game.settings set 1"
            },
            "width": 100
        },
        {
            "label": "重置",
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "tetris:game_settings/reset"
            },
            "width": 100
        },
        {
            "label": "返回",
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "tetris:main_window"
            },
            "width": 100
        }
    ]
}